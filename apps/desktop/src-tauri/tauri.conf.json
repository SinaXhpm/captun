{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Captun",
  "version": "0.1.0",
  "identifier": "app.captun.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Captun",
        "width": 640,
        "height": 420,
        "minWidth": 480,
        "minHeight": 360,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": ["iproute2", "iptables", "iw", "hostapd", "procps", "libudev1"],
        "recommends": ["network-manager", "dnsmasq-base"]
      },
      "rpm": {
        "depends": ["iproute", "iptables", "iw", "hostapd", "procps", "libudev.so.1()(64bit)"],
        "recommends": ["NetworkManager", "dnsmasq", "iptables-nft"]
      }
    }
  }
}
